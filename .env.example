# Copy to .env.local and fill in from your own Supabase project
# (Project Settings > API). Leave both empty to build without cloud backup.

# Public by design: row level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server side only. Set these as Edge Function secrets, never in .env.local
# and never with a VITE_ prefix (that would put them in the browser bundle):
#   supabase secrets set ALLOWED_ORIGIN=https://your-domain
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions by Supabase.
